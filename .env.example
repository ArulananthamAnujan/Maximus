# Copy this file to ".env" and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API
#
# NOTE: Only the "anon"/public key belongs here. NEVER put the service_role
# (secret) key in a VITE_ variable — anything prefixed with VITE_ is bundled
# into the browser and visible to everyone.

# Your Supabase project's API URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Your Supabase public "anon" API key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=
